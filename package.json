{
  "name": "decision-pacman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "tsc --noEmit && vite build --config vite.site.config.ts",
    "build:single": "npm run build:site && tsx scripts/bundle_single_html.ts",
    "preview:site": "vite preview --config vite.site.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "headless": "tsx scripts/run_headless.ts",
    "record": "tsx scripts/record_demo.ts",
    "gen-data": "tsx scripts/gen_teacher_data.ts",
    "systemone-vllm": "tsx scripts/systemone_vllm.ts",
    "render-audio": "tsx scripts/render_audio.ts",
    "eval:openai": "tsx scripts/eval_openai.ts",
    "eval:decisions": "tsx scripts/eval_openai.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
