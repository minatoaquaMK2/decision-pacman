# Decision model endpoint (/v1/systemone): Ollama 0.35+ on 11434, or ollaya on 11435
VITE_DECISION_BASE_URL=http://localhost:11434
# Default decision model
VITE_DEFAULT_MODEL=tev1:4b
# Teacher: any OpenAI-compatible chat completions endpoint
TEACHER_BASE_URL=http://localhost:8000/v1
TEACHER_MODEL=replace-with-your-model-id
# Hosted teacher only (see docs/guides/teacher-api.md): bearer key, JSON merged into each request, retries on 429/5xx
TEACHER_API_KEY=
TEACHER_EXTRA_BODY=
TEACHER_MAX_RETRIES=0
# Set to 1 to record the teacher's per-option probabilities (label_probs) from token logprobs
TEACHER_LOGPROBS=0
# Set to 1 to enable live integration tests against the decision endpoint
LIVE_DECISION_API=0
# TypeSafe's hosted Jev: used by the "jev" policy, and added to /decide requests by the dev server
TYPESAFE_API_KEY=
# OpenAI's Decisions API (GPT-6 Luna): used by the "openai:<model>" policy, and added to /openai requests by the dev server
OPENAI_API_KEY=
